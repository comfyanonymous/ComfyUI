services:
  comfyui:
    volumes:
      - /srv/comfyui/models:/srv/app/models
      - /srv/comfyui/input:/srv/app/input
      - /srv/comfyui/output:/srv/app/output
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: ['1']
              capabilities: [gpu]
